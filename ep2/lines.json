 },
 "l21": {
  "who": "gus",
  "text": "[hopeful] No medicine?"
 },
 "l22": {
  "who": "drmax",
  "text": "[calmly] No. Drink some water and no more burgers today."
 },
 "l23": {
  "who": "gus",
  "text": "[horrified] That sounds worse than medicine!"
 },
 "l24": {
  "who": "sofia",
