 {"id": "d01", "text": "You tipped your DoorDash driver nine dollars."},
 {"id": "d02", "text": "DoorDash just SAVED nine dollars."},
 {"id": "d03", "text": "And your driver?"},
 {"id": "d04", "text": "He didn't earn a CENT more."},
 {"id": "d05", "text": "Here's how it worked."},
 {"id": "d06", "text": "Under DoorDash's old pay system, imagine a driver was guaranteed ten bucks."},
 {"id": "d07", "text": "No tip?"},
 {"id": "d08", "text": "DoorDash paid all ten."},
 {"id": "d09", "text": "Three-dollar tip?"},
 {"id": "d10", "text": "DoorDash paid seven."},
 {"id": "d11", "text": "Nine-dollar tip?"},
 {"id": "d12", "text": "DoorDash paid just ONE."},
 {"id": "d13", "text": "And the driver?"},
 {"id": "d14", "text": "Ten. Ten. Ten."},
 {"id": "d15", "text": "Your tip didn't disappear."},
 {"id": "d16", "text": "It REPLACED money DoorDash would've paid."},
 {"id": "d17", "text": "DoorDash changed the system in 2019."},
 {"id": "d18", "text": "You thought you were ADDING nine dollars to the driver's pay."},
 {"id": "d19", "text": "You were SUBTRACTING nine from DoorDash's bill."}
